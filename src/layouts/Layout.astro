---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: string;
}

const {
  title,
  description = "Herramienta visual para documentar arquitectura de software con el modelo 4+1 de Philippe Kruchten: vistas de Escenarios (casos de uso), Lógica, Proceso, Desarrollo y Física. Diagrama en línea, interactivo y exportable a JSON, Markdown y JWT.",
  canonical,
  image = "https://4plus1model.cafeycodigo.org/favicon.svg",
  type = "website",
} = Astro.props;

const siteUrl = "https://4plus1model.cafeycodigo.org";
const currentCanonical =
  canonical || new URL(Astro.url.pathname, siteUrl).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${siteUrl}/#app`,
      name: "4+1 Modeler - Software Architecture Visual Tool",
      url: siteUrl,
      description:
        "Herramienta web interactiva para modelar, visualizar y compartir arquitectura de software con el modelo 4+1 de Philippe Kruchten (Escenarios, Lógica, Proceso, Desarrollo y Física).",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "All",
      browserRequirements:
        "Requires JavaScript. Compatible with modern web browsers.",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      author: {
        "@type": "Person",
        name: "Benjamin Mora Torres",
        url: "https://www.linkedin.com/in/benjamin-mora-torres/",
      },
      keywords: [
        "4+1 Model",
        "Modelo 4+1",
        "Arquitectura de Software",
        "Software Architecture Diagrams",
        "Use Cases",
        "Casos de Uso",
        "Kruchten",
        "Logical View",
        "Process View",
        "Development View",
        "Physical View",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "4+1 Modeler",
      publisher: {
        "@type": "Person",
        name: "Benjamin Mora Torres",
      },
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="4+1 model, modelo 4+1, arquitectura de software, casos de uso, use cases, modelado de sistemas, philippe kruchten, vista lógica, vista de proceso, vista de desarrollo, vista física, software architecture, software architecture diagrams"
    />
    <meta name="author" content="Benjamin Mora Torres" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#1168bd" />
    <meta name="color-scheme" content="light dark" />

    <!-- Canonical -->
    <link rel="canonical" href={currentCanonical} />

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={currentCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta
      property="og:site_name"
      content="4+1 Modeler · Software Architecture"
    />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={currentCanonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- JSON-LD Structured Data Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      (() => {
        try {
          const urlParams = new URLSearchParams(window.location.search);
          const themeParam = urlParams.get("theme")?.trim().toLowerCase();
          const validTheme =
            themeParam === "light" ||
            themeParam === "dark" ||
            themeParam === "system"
              ? themeParam
              : null;
          if (validTheme) {
            localStorage.setItem("heroui-theme", validTheme);
          }
          const stored =
            validTheme ?? localStorage.getItem("heroui-theme") ?? "system";
          const resolved =
            stored === "system"
              ? window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light"
              : stored;
          document.documentElement.classList.add(resolved);
          document.documentElement.setAttribute("data-theme", resolved);
        } catch {}
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
