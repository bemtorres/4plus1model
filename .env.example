# Archivo de ejemplo para configuración local
# Copia este archivo a .env.local para activar el modo de desarrollo:
# cp .env.example .env.local

# Activa el modo de edición y guardado de diagramas de prueba en archivos JSON (carpeta test-diagrams/)
# Por defecto está desactivado (modo prod).
PUBLIC_DEV_MODE=true
DEV_MODE=true
